<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="web.ActionContainer" owl="1">
        <div class="o_action_manager d-flex flex-column">
            <!-- Show Tabs if we have any tracked actions -->
            <AklMultiTab
                t-if="globalTabs.action_infos.length > 0"
                action_infos="globalTabs.action_infos"
                active_action="(info) => this._on_active_action(info)"
                close_action="(info) => this._on_close_action(info)"
                close_current_action="() => this._close_current_action()"
                close_other_action="() => this._close_other_action()"
                close_all_action="() => this._on_close_all_action()"
            />
            
            <!-- Render the tabs content -->
            <t t-foreach="globalTabs.action_infos" t-as="tab_info" t-key="tab_info.key">
                <div class="akl_controller_container d-flex flex-column" 
                     t-att-class="tab_info.active ? '' : 'd-none'">
                    <t t-component="tab_info.Component" className="'o_action'" t-props="tab_info.componentProps" />
                </div>
            </t>

            <!-- IMPORTANT Fallback: If for some reason our tab state is empty, 
                 we MUST still render Odoo's current action so the screen isn't blank. -->
            <t t-if="globalTabs.action_infos.length === 0 and info">
                <div class="akl_controller_container d-flex flex-column">
                    <t t-component="info.Component" t-props="info.componentProps" t-key="info.id"/>
                </div>
            </t>
        </div>
    </t>
</templates>
